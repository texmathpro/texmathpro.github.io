{
{{- $first := true -}}
{{- range where .Site.RegularPages "Section" "posts" }}
{{- if not $first }},{{ end }}
{{- $first = false }}
{{ .File.ContentBaseName | jsonify }}: {
    "title": {{ .Title | jsonify }},
    "url": {{ .Permalink | jsonify }},
    "price": {{ .Params.price | default 0 }},
    "category": {{ .Params.category | jsonify }},
    "grade": {{ .Params.grade | jsonify }}
}
{{- end }}
}