{
{{- $first := true -}}
{{- range where .Site.RegularPages "Section" "posts" }}
{{- if not $first }},{{ end }}
{{- $first = false }}

{{ lower .File.ContentBaseName | jsonify }}: {
    "title": {{ .Title | jsonify }},
    "url": {{ .Permalink | jsonify }},
    "priceRegular": {{ .Params.priceRegular }},
    "priceDiscounted": {{ .Params.priceDiscounted }},
    "isDiscounted": {{ .Params.isDiscounted }},
    "price": {{ if .Params.isDiscounted }}{{ .Params.priceDiscounted }}{{ else }}{{ .Params.priceRegular }}{{ end }},
    "category": {{ .Params.category | jsonify }},
    "grade": {{ .Params.grade | jsonify }}
}

{{- end }}
}